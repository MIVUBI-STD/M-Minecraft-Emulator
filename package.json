{
  "name": "m-minecraft-emulator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Minecraft Education native and Sandboxie feasibility controller; legacy VMware source retained",
  "engines": {
    "node": "24.x"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "setup": "npm --prefix apps/desktop ci --no-audit --no-fund",
    "dev": "npm --prefix apps/desktop run dev:app",
    "verify:repository": "node tooling/repository/verify.mjs",
    "test": "npm --prefix apps/desktop run test",
    "check:desktop": "npm --prefix apps/desktop run verify:source",
    "check:runtime": "cargo check --locked --all-targets --manifest-path engine/runtime-core/Cargo.toml",
    "test:runtime": "cargo test --locked --all-targets --manifest-path engine/runtime-core/Cargo.toml",
    "format:runtime": "cargo fmt --manifest-path engine/runtime-core/Cargo.toml --all --check",
    "verify:source": "npm run verify:repository -- --g0 && npm run test:localtest && npm run test:feasibility && npm run test:isolation-source && npm run test:native-feasibility && npm run test:sandboxie-feasibility && npm run test:native-performance && npm run check:desktop && npm run check:runtime && npm run test:runtime && npm run format:runtime",
    "package:windows": "npm --prefix apps/desktop run build:app",
    "test:feasibility": "node --test tooling/acceptance/evaluate-client-feasibility.test.mjs",
    "feasibility:review": "node tooling/acceptance/evaluate-client-feasibility.mjs",
    "test:native-feasibility": "node --test tooling/acceptance/evaluate-native-feasibility.test.mjs",
    "native-feasibility:review": "node tooling/acceptance/evaluate-native-feasibility.mjs",
    "test:sandboxie-feasibility": "node --test tooling/acceptance/evaluate-sandboxie-feasibility.test.mjs",
    "test:native-performance": "node --test tooling/acceptance/evaluate-native-performance.test.mjs",
    "native-performance:review": "node tooling/acceptance/evaluate-native-performance.mjs",
    "sandboxie-feasibility:review": "node tooling/acceptance/evaluate-sandboxie-feasibility.mjs",
    "test:localtest": "node --test tooling/local-test/session.test.mjs",
    "test:isolation-source": "node --test tooling/isolation-source/validate-baseline.test.mjs tooling/isolation-source/verify-artifact-files.test.mjs tooling/isolation-source/bootstrap-fork.test.mjs tooling/isolation-source/verify-checkout.test.mjs",
    "isolation-source:verify": "node tooling/isolation-source/validate-baseline.mjs tooling/isolation-source/upstream-baseline.json",
    "isolation-source:bootstrap": "node tooling/isolation-source/bootstrap-fork.mjs",
    "isolation-source:checkout-verify": "node tooling/isolation-source/verify-checkout.mjs"
  }
}
